			if not d.require_range(target,count,"Native graphics resource"): return false
			if resource[1] == "world_tsa":
				if d.u8(target) != 29 or d.u8(target+1) != 19: return false
				for cell in range(600):
					var tile: int = d.u16(target+2+cell*2)
					if tile & 1023 >= 640 or tile >> 12 >= 4: return false
	return true

static func call_target(d: RefCounted, at: int) -> int:
	return Shared.call_target(d,at)

static func describe(d: RefCounted, pointer: int, game: String = "fe7") -> Variant:
	return Shared.describe(d,pointer,game)

static func affiliation(d: RefCounted, pointer: int) -> Variant:
	return Shared.affiliation(d,pointer)
const WRAPPER = Shared.WRAPPER
const AFFILIATION = Shared.AFFILIATION


static func event_word(d: RefCounted, value: int) -> int:
	if not us(d): return value
	if value >= 0x08000000: return 0x08000000+address(d,(value-0x08000000)&~1)+(value&1)
	for native in range(256):
		if preload("res://runtime/fe7/fe7_dynamic_us_profile.gd").opcode(native) == (value&65535): return (value&0xffff0000)|native
	d.fail("FE7 US events","Unmapped dispatcher command.")
	return -1
